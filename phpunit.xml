<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="AccountFeature">
            <directory>plugins/webkul/accounts/tests/Feature</directory>
        </testsuite>
        <testsuite name="PartnerFeature">
            <directory>plugins/webkul/partners/tests/Feature</directory>
        </testsuite>
        <testsuite name="PurchaseFeature">
            <directory>plugins/webkul/purchases/tests/Feature</directory>
        </testsuite>
        <testsuite name="InventoryFeature">
            <directory>plugins/webkul/inventories/tests/Feature</directory>
        </testsuite>
        <testsuite name="SaleFeature">
            <directory>plugins/webkul/sales/tests/Feature</directory>
        </testsuite>
        <testsuite name="ProjectFeature">
            <directory>plugins/webkul/projects/tests/Feature</directory>
        </testsuite>
        <testsuite name="SupportFeature">
            <directory>plugins/webkul/support/tests/Feature</directory>
        </testsuite>
        <testsuite name="ManufacturingFeature">
            <directory>plugins/webkul/manufacturing/tests/Feature</directory>
        </testsuite>
        <!--
        #138 PR4 ola4B: this rollout's 3 new plugins (Maintenance/Security/
        TimeOff) had a tests/Feature directory that was never actually run
        by `vendor/bin/pest`/`composer test` (no explicit path argument)
        until added here — phpunit.xml's own <testsuites> list, not tests/
        Pest.php's `->in('Feature', '../plugins/*/*/tests/Feature')` glob,
        is what determines which directories a bare `pest`/`composer test`
        invocation actually scans. The same gap exists for 6 other plugins
        (analytics, payments, plugin-manager, products, recruitments,
        table-views) — confirmed by a one-off widened run that surfaced
        dozens of pre-existing failures unrelated to company-scope in
        those plugins' own test suites (some from real bugs, others from
        cross-file bootstrap-ordering assumptions that only held by
        accident of phpunit's previous directory list). Fixing those is
        out of scope for this rollout; flagged as a discovered, deferred
        infrastructure issue rather than silently expanded into here.
        -->
        <testsuite name="MaintenanceFeature">
            <directory>plugins/webkul/maintenance/tests/Feature</directory>
        </testsuite>
        <testsuite name="SecurityFeature">
            <directory>plugins/webkul/security/tests/Feature</directory>
        </testsuite>
        <testsuite name="TimeOffFeature">
            <directory>plugins/webkul/time-off/tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
